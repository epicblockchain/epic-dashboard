        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@tanstack/react-table": "^9.2.4",
        "core-js": "^3.20.2",
        "react-window": "^2.3.1",
        "regenerator-runtime": "^0.14.1",
        "winston": "^3.3.3"
    }

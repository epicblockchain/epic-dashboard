{
    "name": "epic-dashboard",
    "productName": "epic-dashboard",
    "version": "4.11.0",
    "description": "Dashboard for ePIC mining rigs.",
    "main": ".webpack/main",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "prestart": "npm run lint -- --fix",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test",
        "format": "prettier --write .",
        "prepare": "husky",
        "release": "release-it --no-npm.publish",
        "release-pub": "release-it --no-npm.publish --git.commitMessage='Release public version ${version}'"
    },
    "keywords": [],
    "author": {
        "name": "ePIC Dashboard",
        "email": "support@epicblockchain.io"
    },
    "license": "GPLv3",
    "engines": {
        "npm": ">=8.0.0",
        "node": "^22.21.0 || >=24.11.0"
    },
    "config": {
        "forge": "./forge.config.cjs"
    },
    "devDependencies": {
        "@amcharts/amcharts4": "^4.10.18",
        "@babel/core": "^8.0.5",
        "@babel/preset-env": "^8.0.5",
        "@babel/preset-react": "^8.0.1",
        "@electron-forge/cli": "^7.11.1",
        "@electron-forge/maker-deb": "^7.11.1",
        "@electron-forge/maker-rpm": "^7.11.1",
        "@electron-forge/maker-squirrel": "^7.11.1",
        "@electron-forge/maker-zip": "^7.11.1",
        "@electron-forge/plugin-webpack": "^7.11.1",
        "@eslint/js": "^10.0.1",
        "@vercel/webpack-asset-relocator-loader": "^1.10.0",
        "babel-loader": "^10.1.1",
        "babel-plugin-polyfill-corejs3": "^1.0.0",
        "css-loader": "^7.1.5",
        "electron": "^44.3.0",
        "electron-squirrel-startup": "^1.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "form-data-encoder": "^4.1.0",
        "globals": "^17.12.0",
        "got": "^16.0.0",
        "husky": "^9.1.7",
        "node-loader": "^2.1.0",
        "prettier": "3.9.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-toastify": "^11.1.0",
        "release-it": "^21.0.2",
        "sha256-file": "^1.0.0",
        "style-loader": "^4.0.0",

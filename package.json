{
    "name": "epic-dashboard",
    "productName": "epic-dashboard",
    "version": "4.10.2",
    "description": "Dashboard for ePIC mining rigs.",
    "main": ".webpack/main",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "prestart": "npm run lint -- --fix",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test",
        "format": "prettier --write .",
        "prepare": "husky",
        "release": "release-it --no-npm.publish",
        "release-pub": "release-it --no-npm.publish --git.commitMessage='Release public version ${version}'"
    },
    "keywords": [],
    "author": {
        "name": "ePIC Dashboard",
        "email": "support@epicblockchain.io"
    },
    "license": "GPLv3",
    "engines": {
        "npm": ">=8.0.0",
        "node": "^22.21.0 || >=24.11.0"
    },
    "config": {
        "forge": {
            "packagerConfig": {
                "icon": "src/img/epic"
            },
            "makers": [
                {
                    "name": "@electron-forge/maker-squirrel",
                    "config": {
                        "name": "epic-dashboard"
                    }
                },
                {
                    "name": "@electron-forge/maker-zip"
                },
                {
                    "name": "@electron-forge/maker-deb",
                    "config": {
                        "options": {
                            "icon": "src/img/epic.png"
                        }
                    }
                },
                {
                    "name": "@electron-forge/maker-rpm",
                    "config": {
                        "options": {
                            "icon": "src/img/epic.png"
                        }
                    }
                }
            ],
            "plugins": [
                {
                    "name": "@electron-forge/plugin-webpack",
                    "config": {
                        "mainConfig": "./webpack.main.config.js",
                        "renderer": {
                            "config": "./webpack.renderer.config.js",
                            "nodeIntegration": true,
                            "entryPoints": [
                                {
                                    "html": "./src/index.html",
                                    "js": "./src/app.jsx",
                                    "name": "main_window"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },
    "devDependencies": {
        "@amcharts/amcharts4": "^4.10.18",
        "@babel/core": "^8.0.5",
        "@babel/preset-env": "^8.0.5",
        "@babel/preset-react": "^8.0.1",
        "@electron-forge/cli": "^7.11.1",
        "@electron-forge/maker-deb": "^7.11.1",
        "@electron-forge/maker-rpm": "^7.11.1",
        "@electron-forge/maker-squirrel": "^7.11.1",
        "@electron-forge/maker-zip": "^7.11.1",
        "@electron-forge/plugin-webpack": "^7.11.1",
        "@eslint/js": "^10.0.1",
        "@vercel/webpack-asset-relocator-loader": "^1.10.0",
        "babel-loader": "^10.1.1",
        "babel-plugin-polyfill-corejs3": "^1.0.0",
        "css-loader": "^7.1.5",
        "electron": "^44.3.0",
        "electron-squirrel-startup": "^1.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "form-data-encoder": "^4.1.0",
        "globals": "^17.12.0",
        "got": "^16.0.0",
        "husky": "^9.1.7",
        "node-loader": "^2.1.0",
        "prettier": "3.9.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-toastify": "^11.1.0",
        "release-it": "^21.0.2",
        "sha256-file": "^1.0.0",
        "style-loader": "^4.0.0",
        "url-loader": "^4.1.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@emotion/react": "^11.10.4",
        "@emotion/styled": "^11.10.4",
        "@mui/icons-material": "^5.10.9",
        "@mui/lab": "^5.0.0-alpha.105",
        "@mui/material": "^5.10.11",
        "@mui/styles": "^6.5.0",
        "@tanstack/react-table": "^9.2.4",
        "core-js": "^3.20.2",
        "react-window": "^1.8.6",
        "regenerator-runtime": "^0.14.1",
        "winston": "^3.3.3"
    }
}
